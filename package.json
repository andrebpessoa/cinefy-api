{
	"name": "cinefy",
	"version": "1.0.50",
	"scripts": {
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:stable": "bun test --rerun-each 3",
		"dev": "bun run --watch src/index.ts",
		"start": "bun run src/index.ts",
		"build:prod": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
		"build:docker:server": "bun build --compile --minify-whitespace --minify-syntax --target \"${BUN_COMPILE_TARGET:-bun-linux-x64}\" --outfile server src/index.ts",
		"build:docker:migrate": "bun build --compile --minify-whitespace --minify-syntax --target \"${BUN_COMPILE_TARGET:-bun-linux-x64}\" --outfile run-migrations src/run-migrations.ts",
		"build:docker": "bun run build:docker:server && bun run build:docker:migrate",
		"build:prod:linux-x64": "BUN_COMPILE_TARGET=bun-linux-x64 bun run build:docker:server",
		"start:prod": "./server",
		"check-types": "bunx tsc --noEmit",
		"ci": "biome check . && bunx tsc --noEmit && bun test",
		"deploy:verify": "bun run ci && docker build -t cinefy:local .",
		"check": "biome check --write .",
		"format": "biome check --write --unsafe .",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"migrate:up": "bun run src/run-migrations.ts"
	},
	"dependencies": {
		"@elysia/cors": "^1.4.2",
		"@elysia/openapi": "^1.4.15",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "^1.6.9",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^1.0.0-beta.22",
		"elysia": "^1.4.28",
		"pg": "^8.20.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/pg": "^8.20.0",
		"bun-types": "latest",
		"drizzle-kit": "^1.0.0-beta.22"
	},
	"engines": {
		"bun": ">=1.3.0"
	}
}
