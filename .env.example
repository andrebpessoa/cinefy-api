# Authentication — em produção: BETTER_AUTH_URL com HTTPS e domínio público da API
BETTER_AUTH_SECRET=your-secret-key
BETTER_AUTH_URL=http://localhost:3000

# Environment — em Dokploy defina NODE_ENV=production
PORT=3000
NODE_ENV=development

# Interface de escuta (0.0.0.0 = todas as interfaces; recomendado em Docker/Dokploy)
HOST=0.0.0.0

# Database — em Docker/Dokploy use o hostname do serviço Postgres na rede (ex.: postgres:5432), não localhost do host
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cinefy

# Docker
# SKIP_DB_MIGRATIONS=1

# Catalog
VOD_PROVIDER_URL=https://your-provider.example/...&action=get_vod_streams
SERIES_PROVIDER_URL=https://your-provider.example/...&action=get_series
LIVE_PROVIDER_URL=https://your-provider.example/...&action=get_live_streams
CATALOG_PROVIDER_TIMEOUT_MS=30000

# CORS
ALLOWED_ORIGINS=http://localhost:3001

# Sync manual protegido
SYNC_API_KEY=generate-a-long-random-secret

# Catálogo — cron em UTC (ex.: a cada 30 min nos minutos 0 e 30)
CATALOG_SYNC_CRON=*/30 * * * *
