# Authentication — produção: BETTER_AUTH_URL com HTTPS e domínio público da API
# BETTER_AUTH_SECRET: mínimo 32 caracteres (ex.: openssl rand -hex 32)
BETTER_AUTH_SECRET=change-me-minimum-32-characters-long-secret
BETTER_AUTH_URL=http://localhost:3000

# Environment — em Dokploy defina NODE_ENV=production
PORT=3000
NODE_ENV=development

# Interface de escuta (0.0.0.0 = todas as interfaces; recomendado em Docker/Dokploy)
HOST=0.0.0.0

# Database — em Docker/Dokploy use o hostname do serviço Postgres na rede (ex.: postgres:5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cinefy

# Docker
# SKIP_DB_MIGRATIONS=true

# Redis — rate limit do catálogo + Better Auth (secondaryStorage / rate limit). `bun run db:up` sobe Redis na porta 6379.
REDIS_URL=redis://localhost:6379

# Catalog — em produção são obrigatórias (validação em src/config/env.ts)
VOD_PROVIDER_URL=https://your-provider.example/player_api.php?username=user&password=pass&action=get_vod_streams
SERIES_PROVIDER_URL=https://your-provider.example/player_api.php?username=user&password=pass&action=get_series
LIVE_PROVIDER_URL=https://your-provider.example/player_api.php?username=user&password=pass&action=get_live_streams
CATALOG_PROVIDER_TIMEOUT_MS=30000

# Limiar de sync resiliente: não aplicar delete em massa se count novo for menor que esta fração do count anterior (0..1)
CATALOG_SYNC_MIN_RETENTION_FRACTION=0.5

# CORS (lista separada por vírgulas)
ALLOWED_ORIGINS=http://localhost:3001

# Sync manual protegido — Bearer; mínimo 24 caracteres recomendado
SYNC_API_KEY=change-me-use-openssl-rand-hex-24

# Catálogo — cron em UTC
CATALOG_SYNC_CRON=*/30 * * * *

# Testes / diagnóstico: desativa validação estrita de env (não usar em produção)
# SKIP_ENV_VALIDATION=true
